# Exemplo de variaveis de ambiente do AgentHub (NAO coloque valores reais aqui).
# Defina-as no sistema/shell; o Spring Boot le diretamente do ambiente.

# Obrigatoria: chave da API Anthropic
ANTHROPIC_API_KEY=

# Opcionais (valores padrao entre parenteses)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_TIMEOUT=PT3M

# Projeto inicial, usado so para criar data/targets.json na primeira execucao (depois: tela Projetos)
# AGENTHUB_TARGET_ROOT=../clientes
# AGENTHUB_TARGET_NAME=clientes
# Arquivo dos projetos cadastrados e pastas-base permitidas (separadas por virgula)
# AGENTHUB_TARGETS_FILE=data/targets.json
# AGENTHUB_ALLOWED_ROOTS=C:/Hamden/Sistemas

# MCP: liga/desliga o cliente MCP e o comando usado para subir o mcp-server-git
# AGENTHUB_MCP_ENABLED=true
# AGENTHUB_UVX_COMMAND=uvx

# Banco do projeto (fonte "database", Postgres MCP Pro em modo restrito). A URI de cada projeto e cadastrada na
# tela Projetos (gravada em data/targets.json); projeto sem URI = fonte indisponivel.
# Usuario somente leitura de exemplo: docs/sql/agenthub-readonly-role.sql
# AGENTHUB_DATABASE_ENABLED=true
# AGENTHUB_POSTGRES_MCP_VERSION=0.3.0

# SERVER_PORT=8090
