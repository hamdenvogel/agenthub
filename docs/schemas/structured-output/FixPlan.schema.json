{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "replace": {
                  "type": "string"
                },
                "search": {
                  "type": "string"
                }
              },
              "required": [
                "replace",
                "search"
              ],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "content",
          "edits",
          "explanation",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "format": "double"
    },
    "manualSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "changes",
    "confidence",
    "manualSteps",
    "risks",
    "summary"
  ],
  "additionalProperties": false
}
